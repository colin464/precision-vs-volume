{
  "name": "precision-vs-volume",
  "main": "worker.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "precision_vs_volume",
      "database_id": "PLACEHOLDER_FILLED_AT_DEPLOY"
    }
  ]
}
